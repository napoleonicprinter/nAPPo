.clear-filters-floating {
    position: fixed;
    bottom: 100px; /* High enough to clear browser bars */
    left: 20px;
    z-index: 9999999;

    display: flex;
    align-items: center;
    gap: 6px;

    background: white;
    color: #ff4444;
    border: 2px solid #ff4444;
    padding: 10px 18px;
    border-radius: 30px;
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    cursor: pointer;

    /* CRITICAL FOR MOBILE MAPS: Force it to the top layer */
    -webkit-transform: translateZ(9999px);
    transform: translateZ(9999px);

    margin-bottom: env(safe-area-inset-bottom);
    pointer-events: auto !important;
}


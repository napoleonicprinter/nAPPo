RewriteEngine On

# Block direct access to IP log file
RewriteRule ^\.patreon_ip_log\.json$ - [F,L]

# Stop rewriting if the request is already for patreon-gate.php
RewriteRule ^patreon-gate\.php$ - [L]

# Route all other requests in this folder through patreon-gate.php
RewriteRule ^(.*)$ patreon-gate.php?file=$1 [QSA,L]
